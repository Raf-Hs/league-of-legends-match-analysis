# Copy to `.env` and fill in your own value, or export OE_API_KEY in your shell.
# The key is NEVER stored in this repository and is ignored by .gitignore.
#
# Windows PowerShell:
#   $env:OE_API_KEY = "<your key>"
# Windows cmd:
#   set OE_API_KEY=<your key>
#
# Only needed for: python src\run_pipeline.py --refresh
# The default pipeline (python src\run_pipeline.py) runs from the cached raw data
# and needs no key at all.
OE_API_KEY=
